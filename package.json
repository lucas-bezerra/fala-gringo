{
  "name": "falagringo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @falagringo/data sync:web && pnpm --filter @falagringo/web dev",
    "build": "pnpm --filter @falagringo/data sync:web && pnpm --filter @falagringo/web build",
    "preview": "pnpm --filter @falagringo/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:golden": "pnpm --filter @falagringo/engine golden"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
