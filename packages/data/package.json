{
  "name": "@falagringo/data",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Pipeline de dicionários (fontes brutas, normalização e shards). Ver SOURCES.md antes de adicionar qualquer fonte.",
  "scripts": {
    "sync:web": "node scripts/sync-web.mjs",
    "typecheck": "tsc --noEmit",
    "import:ipa-dict": "tsx scripts/import-ipa-dict.ts",
    "import:cmudict": "tsx scripts/import-cmudict.ts",
    "import:wikipron": "tsx scripts/import-wikipron.ts",
    "fetch:wikidata": "tsx scripts/fetch-wikidata.ts",
    "import:britfone": "tsx scripts/import-britfone.ts",
    "import:wikidata": "tsx scripts/import-wikidata.ts",
    "import:wiktextract": "tsx scripts/import-wiktextract.ts",
    "extract:wiktextract": "tsx scripts/extract-wiktextract.ts",
    "merge": "tsx scripts/merge.ts",
    "shards": "tsx scripts/build-shards.ts",
    "coverage": "tsx scripts/coverage.ts",
    "notice": "tsx scripts/notice.ts",
    "notice:check": "tsx scripts/notice.ts --check"
  },
  "main": "src/index.ts",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./sources": "./src/sources.ts",
    "./shards": "./src/shards.ts",
    "./ptLexicon": "./src/ptLexicon.ts",
    "./englishStress": "./src/importers/englishStress.ts"
  }
}
